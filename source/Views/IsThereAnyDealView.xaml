<UserControl x:Class="IsThereAnyDeal.Views.IsThereAnyDealView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IsThereAnyDeal.Views"
             xmlns:vm="clr-namespace:IsThereAnyDeal.ViewModels"
             xmlns:converters="clr-namespace:CommonPlayniteShared.Converters"
             xmlns:converters1="clr-namespace:CommonPluginsShared.Converters"
             xmlns:playnitecontrols="clr-namespace:CommonPluginsControls.PlayniteControls"
             xmlns:controls="clr-namespace:CommonPluginsControls.Controls"
             mc:Ignorable="d" d:DesignHeight="740" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:IsThereAnyDealViewModel}"
             Background="{DynamicResource WindowBackgourndBrush}">

    <UserControl.Resources>
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <converters1:ValueOperationConverter x:Key="ValueOperationConverter"/>
        <converters1:LocalDateConverter x:Key="LocalDateConverter"/>

        <Style x:Key="ItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GridItemBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="8,6,12,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Wishlist cards only: tighter padding/margin when IsCompactMode is on (must not affect giveaways). -->
        <Style x:Key="WishlistItemBorderStyle" TargetType="Border" BasedOn="{StaticResource ItemBorderStyle}">
            <Style.Triggers>
                <!-- Two-column cards are standalone ListBoxItems (never IsSelected): focus stands for selection. -->
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="Margin" Value="4,3,6,4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Store filter row: theme CheckBox stacks content horizontally; DockPanel lets the row stretch so counts align right. -->
        <Style x:Key="ItadStoreFilterCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="BulletBorder"
                                        DockPanel.Dock="Left"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Background="{TemplateBinding Background}"
                                        Style="{DynamicResource HighlightBorder}">
                                    <Grid Width="18" Height="18" Background="{DynamicResource NormalBrushDark}">
                                        <Viewbox x:Name="CheckIcon" Visibility="Collapsed">
                                            <TextBlock Text="b"
                                                       FontFamily="Marlett"
                                                       Foreground="{DynamicResource GlyphBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <ContentPresenter RecognizesAccessKey="True"
                                                  Margin="5,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BulletBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Count}" Value="0">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItadBadgeBorder" TargetType="Border">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Background" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Read-only filter recap chip in the collapsed Expander header. -->
        <Style x:Key="ItadFilterSummaryChipBorder" TargetType="Border">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,6,2"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Background" Value="{DynamicResource NormalBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Make listbox items stretch to full width and remove default highlighting -->
        <Style x:Key="ListBoxItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Panel.ZIndex" Value="99"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="100"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HasPriceVisibilityStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPrice}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tag on the ContentControl = localized row label; Content = ItadGameInfo -->
        <DataTemplate x:Key="ItadBestPriceTemplate">
            <StackPanel>
                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                           Text="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Margin="0,0,0,2"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                               Text="{Binding PriceNew}"
                               FontSize="{DynamicResource FontSizeLarger}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                               Text="{Binding CurrencySign}"
                               FontSize="{DynamicResource FontSizeLarger}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ItadBadgeBorder}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPriceCut}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="Bold">
                            <Run Text="-"/><Run Text="{Binding PriceCut}"/><Run Text="%"/>
                        </TextBlock>
                    </Border>
                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                               Text="{Binding ShopName}"
                               Foreground="{Binding ShopColor}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ItadSecondaryPriceTemplate">
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="ItadHistLabel"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="auto" SharedSizeGroup="ItadHistPrice"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Text="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                           Foreground="{DynamicResource TextBrushDarker}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                               Text="{Binding PriceNew}"
                               Foreground="{DynamicResource TextBrushDarker}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Margin="0,0,4,0"/>
                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                               Text="{Binding CurrencySign}"
                               Foreground="{DynamicResource TextBrushDarker}"
                               FontSize="{DynamicResource FontSizeSmall}"/>
                </StackPanel>
                <TextBlock Grid.Column="4"
                           Style="{DynamicResource BaseTextBlockStyle}"
                           Text="{Binding ShopName}"
                           Foreground="{Binding ShopColor}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="ItadBestPriceContentStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource ItadBestPriceTemplate}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content.HasPrice, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItadSecondaryPriceContentStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource ItadSecondaryPriceTemplate}"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content.HasPrice, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GiveawayItemBorderStyle" TargetType="Border" BasedOn="{StaticResource ItemBorderStyle}">
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <TabControl>
            <TabItem Header="{DynamicResource LOCItadWishlist}" Name="PART_Tb">
                <Grid Margin="6">
                    <DockPanel IsEnabled="{Binding IsWishlistContentEnabled}" LastChildFill="True">
                        <!-- Wishlist toolbar: search, stores dropdown, sort, total, refresh menu -->
                        <Border DockPanel.Dock="Top"
                                BorderThickness="{DynamicResource PopupBorderThickness}"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                Margin="0,0,0,6">
                            <DockPanel Margin="8" LastChildFill="False">
                                <playnitecontrols:SearchBox DockPanel.Dock="Left"
                                                           Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Width="220"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center"/>

                                <Border x:Name="PART_StoreFilterRoot"
                                        DockPanel.Dock="Left"
                                        Width="200"
                                        Height="26"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        BorderThickness="{DynamicResource ControlBorderThickness}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Style="{DynamicResource HighlightBorder}"
                                        ToolTip="{Binding SelectedStoresToolTip}">
                                    <Grid>
                                        <ToggleButton x:Name="PART_StoreFilterToggle"
                                                      BorderThickness="0"
                                                      Focusable="True"
                                                      Background="Transparent"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch"
                                                      AutomationProperties.Name="{DynamicResource LOCITADFilterSource}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                            <DockPanel Margin="6,0,4,0" IsHitTestVisible="False">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="&#xEA69;"
                                                           FontFamily="{DynamicResource FontIcoFont}"
                                                           FontSize="10"
                                                           FontWeight="Light"
                                                           Foreground="{DynamicResource GlyphBrush}"
                                                           VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="90"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                           Text="{Binding SelectedStoresText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </ToggleButton>
                                        <Popup Placement="Bottom"
                                               Focusable="False"
                                               AllowsTransparency="True"
                                               StaysOpen="False"
                                               MaxHeight="300"
                                               MinWidth="{Binding ActualWidth, ElementName=PART_StoreFilterRoot}"
                                               IsOpen="{Binding IsChecked, ElementName=PART_StoreFilterToggle, Mode=TwoWay, Delay=100}">
                                            <Border Background="{DynamicResource PopupBackgroundBrush}"
                                                    BorderThickness="{DynamicResource PopupBorderThickness}"
                                                    BorderBrush="{DynamicResource PopupBorderBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="6">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Top"
                                                                Orientation="Horizontal"
                                                                Margin="0,0,0,6">
                                                        <Button Content="{DynamicResource LOCSelectAll}"
                                                                Command="{Binding SelectAllStoresCommand}"
                                                                Margin="0,0,6,0"
                                                                Padding="8,2"/>
                                                        <Button Content="{DynamicResource LOCDeselectAll}"
                                                                Command="{Binding DeselectAllStoresCommand}"
                                                                Padding="8,2"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding FilterStoreItems}"
                                                                  HorizontalContentAlignment="Stretch">
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsCheck, Mode=TwoWay}"
                                                                          Focusable="False"
                                                                          Margin="0,2"
                                                                          Style="{StaticResource ItadStoreFilterCheckBox}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding StoreIcon}"
                                                                                   FontFamily="{DynamicResource CommonFont}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,6,0"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding StoreName}"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,10,0"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding Count}"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                                                   MinWidth="28"
                                                                                   TextAlignment="Right"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                               Text="{Binding LastRefreshLabel}"
                                               ToolTip="{DynamicResource LOCCommonDateData}"
                                               VerticalAlignment="Center"
                                               Opacity="0.75"
                                               Margin="0,0,8,0"/>
                                    <Button Name="PART_BtRefresh"
                                            Style="{DynamicResource IconButton}"
                                            Content="&#xefd1;"
                                            ToolTip="{DynamicResource LOCItadRefresh}"
                                            Click="PART_BtRefresh_Click"
                                            VerticalAlignment="Center">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource LOCITADRefreshPrice}"
                                                          Command="{Binding RefreshPricesCommand}"/>
                                                <MenuItem Header="{DynamicResource LOCCommonRefreshGameData}"
                                                          Command="{Binding RefreshStoresCommand}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ComboBox Width="160"
                                              VerticalAlignment="Center"
                                              SelectedValue="{Binding OrderTypeTag, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              ToolTip="{DynamicResource LOCSettingsTopPanelSortingItem}">
                                        <ComboBoxItem Content="{DynamicResource LOCNameLabel}" Tag="0"/>
                                        <ComboBoxItem Content="{DynamicResource LOCITADOrderBestPriceCut}" Tag="1"/>
                                        <ComboBoxItem Content="{DynamicResource LOCITADOrderBestPrice}" Tag="2"/>
                                        <ComboBoxItem Content="{DynamicResource LOCITADOrderStorePriceCut}" Tag="3"/>
                                        <ComboBoxItem Content="{DynamicResource LOCITADOrderStorePrice}" Tag="4"/>
                                        <ComboBoxItem Content="{DynamicResource LOCGameReleaseDateTitle}" Tag="5"/>
                                    </ComboBox>
                                    <Button Style="{DynamicResource IconButton}"
                                            Content="{Binding OrderDirectionGlyph}"
                                            ToolTip="{Binding OrderDirectionToolTip}"
                                            Command="{Binding ToggleOrderDirectionCommand}"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0"/>
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                               Text="{DynamicResource LOCCommonTotalFound}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                               Text="{Binding FilteredCount, FallbackValue=0}"
                                               VerticalAlignment="Center"
                                               Width="40"
                                               TextAlignment="Right"/>
                                    <CheckBox Content="{DynamicResource LOCItadCompactMode}"
                                              IsChecked="{Binding IsCompactMode, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"/>
                                    <CheckBox Content="{DynamicResource LOCItadMultiColumn}"
                                              IsChecked="{Binding IsMultiColumn, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Expander DockPanel.Dock="Top"
                                  Style="{DynamicResource ModernExpanderStyle}"
                                  Margin="0,0,0,6"
                                  IsExpanded="{Binding FiltersPanelExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Style="{DynamicResource BaseTextBlockStyle}"
                                               Text="{DynamicResource LOCItadFilters}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <ItemsControl ItemsSource="{Binding FiltersSummary}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding FiltersPanelExpanded, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ItadFilterSummaryChipBorder}">
                                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                               Text="{Binding}"
                                                               FontWeight="Normal"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <Grid DockPanel.Dock="Right" Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource LOCITADOn}"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <RadioButton VerticalAlignment="Center"
                                                     Grid.Column="2"
                                                     Content="{DynamicResource LOCITADBestPrice}"
                                                     GroupName="Price"
                                                     IsChecked="{Binding IsBestPriceMode, Mode=TwoWay}"
                                                     Margin="30,0,0,8"/>
                                        <RadioButton VerticalAlignment="Center"
                                                     Grid.Row="2" Grid.Column="2"
                                                     Content="{DynamicResource LOCITADStorePrice}"
                                                     GroupName="Price"
                                                     IsChecked="{Binding IsStorePriceMode, Mode=TwoWay}"
                                                     Margin="30,0,0,8"/>
                                    </Grid>
                                    <Grid DockPanel.Dock="Left" HorizontalAlignment="Right">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="300" MinWidth="150"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" Grid.Row="0"
                                                   Text="{DynamicResource LOCITADPercentage}"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Grid.Column="2" Grid.Row="0"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding DiscountPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="5"
                                                LargeChange="10"
                                                SmallChange="1"
                                                Name="sPercentage"
                                                AutoToolTipPlacement="BottomRight"
                                                AutoToolTipPrecision="0"
                                                IsMoveToPointEnabled="True"/>
                                        <TextBlock Grid.Column="4" Grid.Row="0"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding DiscountPercent, StringFormat={}{0:0}%}"/>
                                        <TextBlock Grid.Column="0" Grid.Row="2"
                                                   Text="{DynamicResource LOCITADPrice}"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Grid.Column="2" Grid.Row="2"
                                                Minimum="{Binding MinPrice}"
                                                Maximum="{Binding MaxPrice}"
                                                Value="{Binding PriceLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="5"
                                                LargeChange="25"
                                                SmallChange="5"
                                                Name="sPrice"
                                                AutoToolTipPlacement="BottomRight"
                                                AutoToolTipPrecision="0"
                                                IsMoveToPointEnabled="True"/>
                                        <TextBlock Grid.Column="4" Grid.Row="2"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding PriceLimit, StringFormat={}{0:0}, Mode=OneWay}"/>
                                            <Run Text="{Binding CurrencySign, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Style="{DynamicResource ModernRadio}"
                                                 Content="{DynamicResource LOCItadWhishListOptionsExcludeInLibrary}"
                                                 GroupName="ItadLibrary"
                                                 IsChecked="{Binding IsLibraryExclude, Mode=TwoWay}"
                                                 Margin="0,0,8,4"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Style="{DynamicResource ModernRadio}"
                                                 Content="{DynamicResource LOCItadWhishListOptionsIncludeInLibrary}"
                                                 GroupName="ItadLibrary"
                                                 IsChecked="{Binding IsLibraryInclude, Mode=TwoWay}"
                                                 Margin="0,0,8,4"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Style="{DynamicResource ModernRadio}"
                                                 Content="{DynamicResource LOCItadWhishListOptionsOnlyInLibrary}"
                                                 GroupName="ItadLibrary"
                                                 IsChecked="{Binding IsLibraryOnly, Mode=TwoWay}"
                                                 Margin="0,0,8,4"
                                                 VerticalAlignment="Center"/>
                                    <ToggleButton Content="{DynamicResource LOCItadWhishListOptionsIncludeWithoutData}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IncludeWithoutData, Mode=TwoWay}"
                                                  Margin="0,0,8,4"/>
                                    <ToggleButton Content="{DynamicResource LOCItadWhishListOptionsAlerts}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AlertsOnly, Mode=TwoWay}"
                                                  Margin="0,0,8,4"/>
                                    <Button Content="{DynamicResource LOCItadWhishListOptionsResetFilters}"
                                            VerticalAlignment="Center"
                                            Command="{Binding ResetFiltersCommand}"
                                            Margin="0,0,0,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Grid>
                            <StackPanel Visibility="{Binding IsWishlistEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20">
                                <TextBlock Text="{DynamicResource LOCItadWishlistEmpty}"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsWishlistNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20">
                                <TextBlock Text="{DynamicResource LOCItadWishlistNoResults}"
                                           Style="{DynamicResource BaseTextBlockStyle}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <Button Content="{DynamicResource LOCItadWhishListOptionsResetFilters}"
                                        Command="{Binding ResetFiltersCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"/>
                            </StackPanel>
                            <ListBox Name="lbWishlist"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <!-- Same virtualized panel in both layouts: one card per item, or one WishlistRow (two cards) per item when IsMultiColumn. -->
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="ItemsSource" Value="{Binding WishlistItems}"/>
                                        <Setter Property="ItemTemplate" Value="{DynamicResource WishlistCardTemplate}"/>
                                        <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemContainerStyle}"/>
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMultiColumn}" Value="True">
                                                <Setter Property="ItemsSource" Value="{Binding WishlistRows}"/>
                                                <Setter Property="ItemTemplate" Value="{DynamicResource WishlistRowTemplate}"/>
                                                <Setter Property="ItemContainerStyle" Value="{DynamicResource WishlistRowContainerStyle}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>

                                <ListBox.Resources>
                                    <DataTemplate x:Key="WishlistCardTemplate">
                                        <Border Style="{StaticResource WishlistItemBorderStyle}">
                                            <DockPanel LastChildFill="True">
                                                <DockPanel.Style>
                                                    <Style TargetType="DockPanel">
                                                        <Setter Property="Margin" Value="0,5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Margin" Value="0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DockPanel.Style>
                                                <!-- Image: 200×100 normal, 120×60 compact -->
                                                <Grid DockPanel.Dock="Left">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Height" Value="100"/>
                                                            <Setter Property="Width" Value="200"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Height" Value="60"/>
                                                                    <Setter Property="Width" Value="120"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Image x:Name="HltbImage"
                                                           Source="{Binding CapsuleImagePath, IsAsync=True}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Linear"/>
                                                    <TextBlock Text="{Binding StoreNameIcon}"
                                                               Foreground="White"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Bottom"
                                                               FontFamily="{DynamicResource CommonFont}"
                                                               Margin="0,0,5,5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="24"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                        <Setter Property="FontSize" Value="16"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="Black" Opacity="1" BlurRadius="5" ShadowDepth="0" RenderingBias="Performance"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <Border Style="{StaticResource ItadBadgeBorder}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="4"
                                                            Visibility="{Binding IsAlert, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            ToolTip="{Binding AlertCriteriaTooltip}">
                                                        <TextBlock Text="{DynamicResource LOCItadAlertBadge}"
                                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="{DynamicResource FontSizeSmall}"/>
                                                    </Border>
                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                            Padding="4,1"
                                                            Cursor="Hand"
                                                            Command="{Binding GoToGame}"
                                                            CommandParameter="{Binding GameId}"
                                                            ToolTip="{Binding LibrarySourcesTooltip}"
                                                            Visibility="{Binding InLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Style="{StaticResource ItadBadgeBorder}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="{DynamicResource LOCItadLibraryBadge}"
                                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="{DynamicResource FontSizeSmall}"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Infos & actions -->
                                                <DockPanel LastChildFill="True">
                                                    <DockPanel.Style>
                                                        <Style TargetType="DockPanel">
                                                            <Setter Property="Margin" Value="10,0,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Margin" Value="6,0,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DockPanel.Style>
                                                    <!-- Card actions: LinksIcon (website) + InstallIcon (buy best). -->
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                Panel.ZIndex="1"
                                                                Margin="8,0,4,0"
                                                                VerticalAlignment="Top"
                                                                ClipToBounds="False">
                                                        <Button Style="{DynamicResource IconButton}"
                                                                Content="&#xef71;"
                                                                ToolTip="{DynamicResource LOCWebsiteLabel}"
                                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding UrlGame}"
                                                                Margin="0,0,4,0"/>
                                                        <Button Content="&#xef08;"
                                                                ToolTip="{DynamicResource LOCItadBuy}"
                                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding ItadBestPrice.UrlBuy}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ItadPriceForWishlistStore.CurrencySign}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ItadPriceForWishlistStore.CurrencySign}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Name & Release date -->
                                                    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                    Margin="0,0,10,0"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReleaseDateNull}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <TextBlock Text="{DynamicResource LOCGameReleaseDateTitle}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Margin="0,0,10,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ReleaseDate, Converter={StaticResource LocalDateConverter}}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Name, FallbackValue=Name}"
                                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                                   FontWeight="Bold"
                                                                   FontSize="{DynamicResource FontSizeLarger}"/>
                                                    </DockPanel>

                                                    <!-- Price & Store -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="1" Grid.IsSharedSizeScope="True">
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource LOCItadNotActive}" Style="{StaticResource BaseTextBlockStyle}" Visibility="{Binding IsActive, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="{DynamicResource LOCItadNotFind}" Style="{StaticResource BaseTextBlockStyle}" Visibility="{Binding IsFind, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="{DynamicResource LOCItadNoData}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ItadBestPrice.HasPrice}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <ContentControl Content="{Binding ItadBestPrice}"
                                                                            Tag="{DynamicResource LOCItadCurrentBest}">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource ItadBestPriceContentStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="Margin" Value="0"/>
                                                                                <Setter Property="ToolTip">
                                                                                    <Setter.Value>
                                                                                        <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                            <StackPanel Grid.IsSharedSizeScope="True">
                                                                                                <ContentControl Style="{StaticResource ItadSecondaryPriceContentStyle}"
                                                                                                                Content="{Binding ItadAllTimeLow}"
                                                                                                                Tag="{DynamicResource LOCItadAllTimeLow}"/>
                                                                                                <ContentControl Style="{StaticResource ItadSecondaryPriceContentStyle}"
                                                                                                                Content="{Binding ItadY1}"
                                                                                                                Tag="{DynamicResource LOCItadYearLow}"/>
                                                                                                <ContentControl Style="{StaticResource ItadSecondaryPriceContentStyle}"
                                                                                                                Content="{Binding ItadM3}"
                                                                                                                Tag="{DynamicResource LOCItadMonthLow}"/>
                                                                                            </StackPanel>
                                                                                        </ToolTip>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                            <StackPanel>
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <ContentControl Style="{StaticResource ItadSecondaryPriceContentStyle}"
                                                                                Content="{Binding ItadAllTimeLow}"
                                                                                Tag="{DynamicResource LOCItadAllTimeLow}"/>
                                                                <ContentControl Style="{StaticResource ItadSecondaryPriceContentStyle}"
                                                                                Content="{Binding ItadY1}"
                                                                                Tag="{DynamicResource LOCItadYearLow}"/>
                                                                <ContentControl Style="{StaticResource ItadSecondaryPriceContentStyle}"
                                                                                Content="{Binding ItadM3}"
                                                                                Tag="{DynamicResource LOCItadMonthLow}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Store prices: ItemsControl (no nested ScrollViewer) so the wishlist ListBox keeps the mouse wheel. -->
                                                        <ItemsControl Grid.Column="3"
                                                                      ItemsSource="{Binding ListItadPriceForWishlistStore}"
                                                                      Focusable="False"
                                                                      IsTabStop="False"
                                                                      HorizontalContentAlignment="Stretch">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel Margin="0,2" LastChildFill="True">
                                                                        <TextBlock DockPanel.Dock="Left"
                                                                                   Text="{DynamicResource LOCItadCurrentStore}"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,10,0"/>
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding UrlBuy}"
                                                                                    Content="&#xef71;"
                                                                                    ToolTip="{DynamicResource LOCItadBuyAtStore}"
                                                                                    Margin="5,0,0,0">
                                                                                <Button.Style>
                                                                                    <Style TargetType="Button" BasedOn="{StaticResource ListRowHoverRevealIconButton}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding UrlBuy}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding UrlBuy}" Value="">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Button.Style>
                                                                            </Button>
                                                                            <Button Style="{DynamicResource ListRowHoverRevealIconButton}"
                                                                                    Content="&#xef22;"
                                                                                    ToolTip="{DynamicResource LOCHideGame}"
                                                                                    Command="{Binding DataContext.HideWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Margin="5,0,0,0"/>
                                                                            <Button Style="{DynamicResource ListRowHoverRevealIconButton}"
                                                                                    Content="&#xec53;"
                                                                                    Foreground="OrangeRed"
                                                                                    ToolTip="{DynamicResource LOCRemoveTitle}"
                                                                                    IsEnabled="{Binding CanRemoveFromStore}"
                                                                                    Command="{Binding DataContext.RemoveWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Margin="6,0,0,0"/>
                                                                        </StackPanel>
                                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource HasPriceVisibilityStyle}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                            <Run Text="{Binding PriceNew, Mode=OneWay}"/>
                                                                            <Run Text="{Binding CurrencySign, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource HasPriceVisibilityStyle}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                            <Run Text="{Binding PriceCut, Mode=OneWay}"/>
                                                                            <Run Text="%"/>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding ShopName}"
                                                                                   Foreground="{Binding ShopColor}"
                                                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DockPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>

                                    <!-- Row container: layout only; hover, focus and selection belong to each card's ListBoxItem. -->
                                    <Style x:Key="WishlistRowContainerStyle" TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- Card hosted in a row: a standalone ListBoxItem so card styles keep resolving their ListBoxItem ancestor. -->
                                    <Style x:Key="WishlistRowCardStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemContainerStyle}">
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ContentTemplate" Value="{DynamicResource WishlistCardTemplate}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Content" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>

                                    <DataTemplate x:Key="WishlistRowTemplate">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ListBoxItem Grid.Column="0" Content="{Binding Left}" Style="{StaticResource WishlistRowCardStyle}"/>
                                            <ListBoxItem Grid.Column="1" Content="{Binding Right}" Style="{StaticResource WishlistRowCardStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.Resources>
                            </ListBox>
                        </Grid>
                    </DockPanel>

                    <Grid Visibility="{Binding IsWishlistLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                          IsHitTestVisible="{Binding IsWishlistInteractionBlocked}">
                        <ProgressBar IsIndeterminate="True" Width="350" Height="40"/>
                        <TextBlock Text="{Binding LoadStatus}"
                                   Style="{DynamicResource BaseTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource LOCItadGiveaways}">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{DynamicResource LOCItadGiveawaysEmpty}"
                                   Style="{DynamicResource BaseTextBlockStyle}"
                                   Visibility="{Binding IsGiveawaysEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="20"/>
                        <ListBox ItemsSource="{Binding GiveawaysItems}"
                             IsEnabled="{Binding IsGiveawaysContentEnabled}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Top-aligned: otherwise rows are stretched to the viewport height. -->
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GiveawayItemBorderStyle}">
                                    <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Left"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{Binding ImagePath, IsAsync=True}"
                                                   Stretch="UniformToFill"
                                                   Width="145"
                                                   Height="72"
                                                   ClipToBounds="True"
                                                   RenderOptions.BitmapScalingMode="Linear"/>
                                            <Border Style="{StaticResource ItadBadgeBorder}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="4"
                                                    Visibility="{Binding HasMultipleGames, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    ToolTip="{DynamicResource LOCItadGiveawayExtraGames}">
                                                <TextBlock Text="{Binding ExtraGamesLabel}"
                                                           Style="{DynamicResource BaseTextBlockStyle}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="{DynamicResource FontSizeSmall}"/>
                                            </Border>
                                        </Grid>

                                        <Button DockPanel.Dock="Right"
                                                Style="{DynamicResource IconButton}"
                                                Content="&#xef71;"
                                                ToolTip="{DynamicResource LOCWebsiteLabel}"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Link}"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"/>

                                        <StackPanel VerticalAlignment="Center">
                                            <controls:TextBlockTrimmed Text="{Binding Title}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap"/>
                                            <controls:TextBlockTrimmed Text="{Binding ShopName}"
                                                                       Style="{DynamicResource BaseTextBlockStyle}"
                                                                       Foreground="{Binding ShopColorBrush}"
                                                                       Margin="0,1,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,8,0"
                                                            Visibility="{Binding HasStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{DynamicResource LOCItadGiveawayStarts}"
                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                               Margin="0,0,4,0"
                                                               Opacity="0.75"/>
                                                    <TextBlock Text="{Binding Start, Converter={StaticResource LocalDateConverter}}"
                                                               Style="{DynamicResource BaseTextBlockStyle}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasExpiry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{DynamicResource LOCItadGiveawayEnds}"
                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                               Margin="0,0,4,0"
                                                               Opacity="0.75"/>
                                                    <TextBlock Text="{Binding Time, Converter={StaticResource LocalDateConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Style="{StaticResource ItadBadgeBorder}"
                                                        Margin="0,0,4,0"
                                                        Background="{DynamicResource PositiveRatingBrush}"
                                                        Visibility="{Binding InWaitlist, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="{DynamicResource LOCItadInWaitlist}">
                                                    <TextBlock Text="{DynamicResource LOCItadInWaitlist}"
                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="{DynamicResource FontSizeSmall}"/>
                                                </Border>
                                                <Border Style="{StaticResource ItadBadgeBorder}"
                                                        Margin="0,0,4,0"
                                                        Visibility="{Binding InCollection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="{DynamicResource LOCItadInCollection}">
                                                    <TextBlock Text="{DynamicResource LOCItadInCollection}"
                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="{DynamicResource FontSizeSmall}"/>
                                                </Border>
                                                <Border Style="{StaticResource ItadBadgeBorder}"
                                                        Margin="0,0,4,0"
                                                        Background="{DynamicResource WarningBrush}"
                                                        Visibility="{Binding IsMature, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="{DynamicResource LOCItadMature}">
                                                    <TextBlock Text="{DynamicResource LOCItadMature}"
                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="{DynamicResource FontSizeSmall}"/>
                                                </Border>
                                                <Border Style="{StaticResource ItadBadgeBorder}"
                                                        Background="{DynamicResource ControlBackgroundBrush}"
                                                        BorderBrush="{DynamicResource GlyphBrush}"
                                                        BorderThickness="{DynamicResource ControlBorderThickness}"
                                                        Visibility="{Binding DrmFree, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTip="{DynamicResource LOCItadDrmFree}">
                                                    <TextBlock Text="{DynamicResource LOCItadDrmFree}"
                                                               Style="{DynamicResource BaseTextBlockStyle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="{DynamicResource FontSizeSmall}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource LOCCommonDateData}"
                                   Style="{DynamicResource BaseTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding GiveawaysLastRefreshLabel}"
                                   Style="{DynamicResource BaseTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   MinWidth="120"/>
                        <Button Style="{DynamicResource IconButton}"
                                Content="&#xefd1;"
                                ToolTip="{DynamicResource LOCItadRefreshGiveaways}"
                                IsEnabled="{Binding IsGiveawaysContentEnabled}"
                                Command="{Binding RefreshGiveawaysCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
